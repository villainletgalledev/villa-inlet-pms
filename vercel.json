{
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/server-app.cjs,node_modules/.prisma/client/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-ical",
      "schedule": "0 3 * * *"
    }
  ]
}
